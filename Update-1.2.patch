--- a/app/build.gradle
+++ b/app/build.gradle
@@ -3,6 +3,19 @@ plugins {
     id 'org.jetbrains.kotlin.android'
 }
 
+// Nomor build mengikuti nomor run GitHub Actions (dipakai fitur Update di aplikasi).
+def runNumber = (System.getenv("GITHUB_RUN_NUMBER") ?: "0").toInteger()
+
+// Keystore tetap (disimpan sebagai teks base64) supaya APK dari tiap build punya tanda tangan sama,
+// sehingga aplikasi bisa memperbarui dirinya sendiri tanpa harus uninstall.
+def keystoreB64 = file("nexus-debug.keystore.b64")
+def keystoreOut = file("$projectDir/.signing/nexus-debug.keystore")
+def hasKeystore = keystoreB64.exists()
+if (hasKeystore) {
+    keystoreOut.parentFile.mkdirs()
+    keystoreOut.bytes = keystoreB64.text.replaceAll("\\s", "").decodeBase64()
+}
+
 android {
     namespace 'com.nexus.asisten'
     compileSdk 33
