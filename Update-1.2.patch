         targetSdk 33
-        versionCode 1
-        versionName "2.0.0"
+        versionCode 100 + runNumber
+        versionName "1.2"
+        buildConfigField "int", "BUILD_NUMBER", "${runNumber}"
+        buildConfigField "String", "UPDATE_REPO", "\"FeynJf/NexusAsisten\""
+    }
+
+    signingConfigs {
+        nexus {
+            if (hasKeystore) {
+                storeFile keystoreOut
+                storePassword "nexus123"
+                keyAlias "nexus"
+                keyPassword "nexus123"
+            }
+        }
     }
 
     buildTypes {
+        debug {
+            if (hasKeystore) signingConfig signingConfigs.nexus
+        }
         release {
             minifyEnabled false
             proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
