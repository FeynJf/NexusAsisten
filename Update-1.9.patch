+        }
+    }
+
+    private fun open(site: Site) {
+        val wv = web ?: return
+        wv.settings.userAgentString = if (site.desktop) DESKTOP_UA else null
+        titleView?.text = site.name
+        wv.loadUrl(site.url)
+    }
+
+    private fun toggleTyping(label: TextView) {
+        val lp = params ?: return
+        val r = root ?: return
+        typing = !typing
