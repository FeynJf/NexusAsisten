+        }
+        if (immediate) { remove(); return }
+        val a0 = r.alpha
+        val s0 = r.scaleX
+        anim = Motion.run(220, 0, { remove() }) { t ->
+            val e = Motion.inCubic(t)
+            r.alpha = a0 * (1f - e)
+            val sc = s0 - 0.1f * e
+            r.scaleX = sc; r.scaleY = sc
+        }
+    }
+}
